# Names only. Fill values in Vercel / Supabase env settings, never in the repo.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Public site origin once the domain is decided, e.g. https://example.com (no trailing slash). Falls back to VERCEL_URL.
SITE_URL=
# Set to true on production only when the domain is approved and the site should be indexed.
ALLOW_INDEXING=
# Secret for POST /api/revalidate (header x-revalidate-secret).
REVALIDATE_SECRET=
